{
    "general": {
        "data_path": "data/CellTracking/<DATASET_NAME>",
        "result_folder": "results/<DATASET_NAME>",
        "plot_folder": "results/<DATASET_NAME>/plots",
        "itksnap_output_dir": "results/workspace_files",
        "background_instance": 0,
        "ignore_label": -1,
        "information_sources": [
            "label",
            "nifti",
            "microscopy_metadata",
            "rgb",
            "across_channel_instance_matching",
            "lineage_graph"
        ],
        "base_information_source": "nifti",
        "only_use_this_subjects": null,
        "verbose": true,
        "channel_mapping": {
            "Cells": 0
        },
        "pipeline": "CellTracking"
    },
    "InstanceLabeler": {
        "max_num_threads": 1,
        "padding_factor": 0.2,
        "settings": [
            {
                "channel": "channel_1",
                "instance_segmentation_from_binary": true,
                "binary_label_setting": "manual",
                "volume_min": 0,
                "volume_max": "inf"
            }
        ]
    },
    "GreedyRegistrator": {
        "settings": {
            "threads": null,
            "mode": "all_to_preceding_timepoint",
            "max_iterations": [
                100,
                50,
                30
            ],
            "metric": "WNCC",
            "patch_radius": [
                2,
                2,
                2
            ],
            "ia_image_centers": true,
            "registration_type": "affine",
            "dimensions": 2,
            "only_apply_already_available_registration": false,
            "only_calculate_overlap": false,
            "channel_to_be_registered": "channel_1",
            "apply_to_other_channels": [
            ],
            "apply_to_labels": {
                "channel_1": [
                    "manual"
                ]
            }
        }
    },
    "InstanceMatcher": {
        "max_num_threads": 1,
        "enforce_no_merge": true,
        "enforce_no_split": false,
        "mode": "pairwise",
        "registration_to": "preceding_timepoint",
        "label_settings_per_channel": [
            {
                "channel_1": "manual"
            }
        ]
    },
    "Cell_Tracking_Dataset": {
        "label_setting": "manual",
        "video_setting": {
            "background_color": {
                "r": 255,
                "g": 255,
                "b": 255
            }
        }
    }
}